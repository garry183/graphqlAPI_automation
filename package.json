{
  "name": "graphqlapi_automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript GraphQL API test framework: public APIs plus a local hardened target",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "playwright test --project=local",
    "test:public": "playwright test --project=public",
    "schema:update": "playwright test tests/public/schema-drift.spec.ts --update-snapshots",
    "server": "tsx server/server.ts",
    "typecheck": "tsc -p .",
    "report": "playwright show-report",
    "selftest": "node scripts/selftest.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
